FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive PIP_NO_CACHE_DIR=1 PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates git libglib2.0-0 libgl1 python3.10 python3-pip \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m pip install --upgrade pip setuptools wheel \
    && python3 -m pip install torch==2.1.2+cu118 torchvision==0.16.2+cu118 \
        --index-url https://download.pytorch.org/whl/cu118

WORKDIR /app
COPY . /app
RUN grep -v -E '^(--find-links|torch==|torchvision$|transformers$)' requirements.txt > /tmp/requirements.txt \
    && python3 -m pip install transformers==4.40.1 -r /tmp/requirements.txt
